MainTab:CreateToggle({
   Name = "7. Wallbang (ปิดการชนของสิ่งกีดขวาง)",
   CurrentValue = false,
   Callback = function(Value) 
      WallbangEnabled = Value 
      task.spawn(function()
          for _, obj in pairs(workspace:GetDescendants()) do
              if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                  local isPlayerPart = false
                  for _, p in pairs(Players:GetPlayers()) do
                      if p.Character and obj:IsDescendantOf(p.Character) then
                          isPlayerPart = true
                          break
                      end
                  end
                  
                  if not isPlayerPart then
                      if WallbangEnabled then
                          if not obj:GetAttribute("OriginalCanCollide") then
                              obj:SetAttribute("OriginalCanCollide", obj.CanCollide)
                          end
                          obj.CanCollide = false
                      else
                          if obj:GetAttribute("OriginalCanCollide") ~= nil then
                              obj.CanCollide = obj:GetAttribute("OriginalCanCollide")
                          end
                      end
                  end
              end
          end
      end)
   end,
})

-- 🔫 ฟังก์ชันที่ 8: เสกปืนเข้าตัวผู้เล่น (Give All Available Guns)
MainTab:CreateButton({
   Name = "8. Give Guns (เสกปืน/ดึงอาวุธเข้าตัว)",
   Callback = function()
      local count = 0
      local backpack = LocalPlayer:FindFirstChild("Backpack")
      
      if not backpack then
         Rayfield:Notify({
            Title = "Error",
            Content = "ไม่พบ Backpack ของผู้เล่น",
            Duration = 3,
         })
         return
      end

      -- 1. ค้นหาปืน/อาวุธที่อยู่ใน Workspace (เช่น ปืนที่ตกอยู่ตามพื้น)
      for _, item in pairs(workspace:GetDescendants()) do
         if item:IsA("Tool") and not item:IsDescendantOf(LocalPlayer.Character) then
            -- ตรวจสอบว่าไม่อยู่ในตัวผู้เล่นคนอื่น
            local inOtherPlayer = false
            for _, p in pairs(Players:GetPlayers()) do
               if p.Character and item:IsDescendantOf(p.Character) then
                  inOtherPlayer = true
                  break
               end
            end
            
            if not inOtherPlayer then
               item.Parent = backpack
               count = count + 1
            end
         end
      end

      -- 2. ค้นหาปืน/อาวุธใน ReplicatedStorage (กรณีมีพรีเซ็ตอาวุธในเกม)
      for _, item in pairs(ReplicatedStorage:GetDescendants()) do
         if item:IsA("Tool") then
            local clonedItem = item:Clone()
            clonedItem.Parent = backpack
            count = count + 1
         end
      end

      -- แจ้งเตือนเมื่อเสกปืนสำเร็จ
      if count > 0 then
         Rayfield:Notify({
            Title = "Success!",
            Content = "ดึงปืน/อาวุธเข้าตัวเรียบร้อยแล้ว ทั้งหมด " .. tostring(count) .. " ชิ้น",
            Duration = 4,
            Image = 4483362458,
         })
      else
         Rayfield:Notify({
            Title = "Notice",
            Content = "ไม่พบปืนในฉาก หรือระบบป้องกันของเซิร์ฟเวอร์บล็อกการดึงข้อมูลไว้",
            Duration = 4,
         })
      end
   end,
})

-- ================= Render & Loops ================= --

local Tracers = {}

RunService.RenderStepped:Connect(function()
    if FOVCircle then
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Radius = FOVRadius
        FOVCircle.Visible = FOVCircleEnabled
    end

    local targetPlayer = GetClosestTarget()

    -- Aimbot Logic
    if AimbotEnabled and targetPlayer and targetPlayer.Character then
        local targetPart = targetPlayer.Character:FindFirstChild(AimPart) or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetPart then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        end
    end

    -- ESP & Tracers Logic
    for _, player in pairs(Players:GetPlayers()) do
        local isEnemy = (player ~= LocalPlayer) and (not LocalPlayer.Team or player.Team ~= LocalPlayer.Team)

        if isEnemy and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local isAlive = not humanoid or humanoid.Health > 0

            if isAlive then
                -- ESP
                local highlight = player.Character:FindFirstChild("ESPHighlight")
                if ESPEnabled then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "ESPHighlight"
                        highlight.FillColor = Color3.fromRGB(128, 0, 128)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.FillTransparency = 0.5
                        highlight.Parent = player.Character
                    end
                else
                    if highlight then highlight:Destroy() end
                end

                -- Tracers
                if TracersEnabled and Drawing then
                    if not Tracers[player] then
                        pcall(function()
                            Tracers[player] = Drawing.new("Line")
                            Tracers[player].Color = Color3.fromRGB(255, 0, 0)
                            Tracers[player].Thickness = 1.5
                        end)
                    end

                    if Tracers[player] then
                        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            Tracers[player].From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            Tracers[player].To = Vector2.new(pos.X, pos.Y)
                            Tracers[player].Visible = true
                        else
                            Tracers[player].Visible = false
                        end
                    end
                else
                    if Tracers[player] then Tracers[player].Visible = false end
                end
            else
                if Tracers[player] then Tracers[player].Visible = false end
                if player.Character:FindFirstChild("ESPHighlight") then player.Character.ESPHighlight:Destroy() end
            end
        else
            if Tracers[player] then Tracers[player].Visible = false end
            if player.Character and player.Character:FindFirstChild("ESPHighlight") then player.Character.ESPHighlight:Destroy() end
        end
    end
end)

-- Silent Aim Loop
task.spawn(function()
    while task.wait(0.05) do
        if SilentAimEnabled then
            local targetPlayer = GetClosestTarget()
            if targetPlayer and targetPlayer.Character then
                local targetPart = targetPlayer.Character:FindFirstChild(AimPart) or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    pcall(function()
                        ReplicatedStorage.SpawnGalaxyBlock.Event:FireServer(targetPart.Position)
                    end)
                end
            end
        end
    end
end)

