-- [[ Main Render Loop ]]
local Drawings = {}

RunService.RenderStepped:Connect(function()
    -- FOV Position Update
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = Settings.FOVSize
    FOVCircle.Visible = Settings.ShowFOV

    -- Event Trigger
    if Settings.AutoEvent then
        pcall(function()
            if ReplicatedStorage:FindFirstChild("SpawnGalaxy") then
                ReplicatedStorage.SpawnGalaxy:FireServer()
            end
        end)
    end

    -- ESP & Tracer Update
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local enemy = IsEnemy(player)

            if enemy and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 then
                if not Drawings[player] then
                    Drawings[player] = {
                        Box = Drawing.new("Square"),
                        Tracer = Drawing.new("Line")
                    }
                    -- Purple Box
                    Drawings[player].Box.Color = Color3.fromRGB(180, 0, 255)
                    Drawings[player].Box.Thickness = 1.5
                    Drawings[player].Box.Filled = false

                    -- Red Tracer
                    Drawings[player].Tracer.Color = Color3.fromRGB(255, 0, 0)
                    Drawings[player].Tracer.Thickness = 1
                end

                local hrp = char.HumanoidRootPart
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    -- Render Purple Box
                    if Settings.ESP_Box then
                        local head = char:FindFirstChild("Head")
                        local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                        local height = math.abs(vector.Y - headPos.Y) * 2
                        local width = height / 1.4

                        Drawings[player].Box.Size = Vector2.new(width, height)
                        Drawings[player].Box.Position = Vector2.new(vector.X - width / 2, vector.Y - height / 2)
                        Drawings[player].Box.Visible = true
                    else
                        Drawings[player].Box.Visible = false
                    end

                    -- Render Red Tracer
                    if Settings.ESP_Tracer then
                        Drawings[player].Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        Drawings[player].Tracer.To = Vector2.new(vector.X, vector.Y)
                        Drawings[player].Tracer.Visible = true
                    else
                        Drawings[player].Tracer.Visible = false
                    end
                else
                    Drawings[player].Box.Visible = false
                    Drawings[player].Tracer.Visible = false
                end
            else
                if Drawings[player] then
                    Drawings[player].Box.Visible = false
                    Drawings[player].Tracer.Visible = false
                end
            end
        end
    end
end)

-- Cleanup on Player Leave
Players.PlayerRemoving:Connect(function(player)
    if Drawings[player] then
        if Drawings[player].Box then Drawings[player].Box:Remove() end
        if Drawings[player].Tracer then Drawings[player].Tracer:Remove() end
        Drawings[player] = nil
    end
end)

