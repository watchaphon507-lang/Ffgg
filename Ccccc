-- Hook Function เพื่อดักจับ Event "SpawnGalaxy" ไม่ให้ยิงรบกวนหรือตรวจจับได้
local gmt = getrawmetatable(game)
local oldNamecall = gmt.__namecall
setreadonly(gmt, false)

gmt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if ProtectionEnabled and tostring(self) == "SpawnGalaxy" and method == "FireServer" then
        -- ขัดขวางการส่งข้อมูลที่เป็นอันตราย / ป้องกันการสแปมแบน
        return nil
    end
    return oldNamecall(self, ...)
end)
setreadonly(gmt, true)


