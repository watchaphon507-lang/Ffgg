MiscTab:CreateButton({
   Name = "ยิง Event SpawnGalaxyBlock",
   Callback = function()
      local success, err = pcall(function()
         game:GetService("ReplicatedStorage").SpawnGalaxyBlock.Event:FireServer()
      end)
