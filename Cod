   CurrentOption = {"Head"},
   MultipleOptions = false,
   Flag = "TargetPartDropdown",
   Callback = function(Option)
       Config.TargetPart = Option[1]
   end,
})

MainTab:CreateSlider({
   Name = "ความสมูทในการล็อก (Smoothness)",
   Range = {1, 10},
   Increment = 1,
   Suffix = "Speed",
   CurrentValue = 5,
   Flag = "SmoothSlider",
   Callback = function(Value)
       Config.Smoothness = Value / 25
   end,
})

-- ปุ่มยิง Remote Event ที่แจ้งไว้
MainTab:CreateButton({
