   CurrentValue = false,
   Flag = "FOVToggle",
   Callback = function(Value)
       Config.FOVVisible = Value
   end,
})

VisualsTab:CreateSlider({
   Name = "ปรับขนาดเป้าวงกลม (Radius)",
   Range = {40, 400},
   Increment = 5,
   Suffix = "px",
   CurrentValue = 120,
   Flag = "FOVSlider",
   Callback = function(Value)
       Config.FOVRadius = Value
   end,
})

-- [3] ระบบเส้นสีแดง (Tracers)
VisualsTab:CreateToggle({
   Name = "แสดงเส้นชี้เป้าสีแดง (Tracers)",
   CurrentValue = false,
   Flag = "TracersToggle",
   Callback = function(Value)
       Config.TracersEnabled = Value
       if not Value then
           ClearTracers()
       end
   end,
})

-- ----------------------------------------------------------------
-- MAIN LOOP (RenderStepped)
-- ----------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    -- อัปเดตขนาดและตำแหน่ง FOV Circle
    FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y + 36)
    FOVCircle.Radius = Config.FOVRadius
    FOVCircle.Visible = Config.FOVVisible

    -- การทำงานของ Aimbot
    if Config.AimbotEnabled then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild(Config.TargetPart) then
            local targetPos = target.Character[Config.TargetPart].Position
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), Config.Smoothness)
        end
    end

    -- การทำงานของ Tracers (เส้นสีแดง)
    if Config.TracersEnabled then
        ClearTracers()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.Humanoid.Health > 0 then
                local partPos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                if onScreen then
                    local tracer = Drawing.new("Line")
                    tracer.Visible = true
                    tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y) -- ลากจากขอบล่างกลางจอ
                    tracer.To = Vector2.new(partPos.X, partPos.Y)
                    tracer.Color = Color3.fromRGB(255, 0, 0) -- สีแดง
                    tracer.Thickness = 1.5
                    tracer.Transparency = 1
                    table.insert(ActiveTracers, tracer)
                end
            end
        end
    end
end)
