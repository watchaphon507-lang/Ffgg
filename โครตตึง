-- Anti-Ban (Bypass Client Detection)
----------------------------------------------------------------
pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() and (method == "Kick" or method == "kick") then
            return nil
        end
        return oldNamecall(self, ...)
    end)
end)

