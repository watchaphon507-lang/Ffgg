local success, err = pcall(function()

    -- 1. Load Rayfield UI Library
    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

    local Window = Rayfield:CreateWindow({
       Name = "Galaxy Hub | Gun Mod & Aim",
       LoadingTitle = "Galaxy Hub Loading...",
       LoadingSubtitle = "by Assistant",
       ConfigurationSaving = { Enabled = false },
       KeySystem = false
    })

    local MainTab = Window:CreateTab("Main Features", 4483362458)

    -- Variables
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local Camera = workspace.CurrentCamera
    local RunService = game:GetService("RunService")

    local AimbotEnabled = false
    local AimPartOption = "Head"
    local AimOffsetY = 1.0 -- ปรับดันเป้าขึ้นเข้าหัว/อก
    local FOVCircleEnabled = false
    local FOVRadius = 250
    local TracersEnabled = false
    local ESPEnabled = false

    -- Mod Gun Variables
    local InfiniteAmmo = false
    local RapidFire = false
    local NoRecoil = false

    -- FOV Circle
    local FOVCircle = nil
    pcall(function()
        if Drawing then
            FOVCircle = Drawing.new("Circle")
            FOVCircle.Color = Color3.fromRGB(255, 255, 0)
            FOVCircle.Thickness = 1.5
            FOVCircle.NumSides = 60
            FOVCircle.Filled = false
            FOVCircle.Visible = false
        end
    end)

    -- 🎯 ฟังก์ชันดึงพิกัดเป้าหมาย (ปรับความสูงแก้เป้าลงต่ำ)
    local function GetTargetPosition(character)
        if not character then return nil end

        local targetPart = nil
        if AimPartOption == "Head" then
            targetPart = character:FindFirstChild("Head") 
                or character:FindFirstChild("head") 
                or character:FindFirstChild("UpperTorso")
        else
            targetPart = character:FindFirstChild("HumanoidRootPart") 
                or character:FindFirstChild("Torso") 
                or character:FindFirstChild("UpperTorso")
        end

        if targetPart then
            return targetPart.Position + Vector3.new(0, AimOffsetY, 0)
        end
        return nil
    end

    -- 🎯 ค้นหาเป้าหมาย
    local function GetClosestTarget()
        local target = nil
        local shortestDistance = FOVRadius
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local targetPos = GetTargetPosition(player.Character)
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")

                if targetPos and (not humanoid or humanoid.Health > 0) then
                    local pos, onScreen = Camera:WorldToViewportPoint(targetPos)
                    if onScreen then
                        local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                        if distance < shortestDistance then
                            target = player
                            shortestDistance = distance
                        end
                    end
                end
            end
        end
        return target
    end

    -- ================= UI Controls ================= --

    MainTab:CreateToggle({
       Name = "1. Aimbot (ล็อกเป้าตรงตัว)",
       CurrentValue = false,
       Callback = function(Value) AimbotEnabled = Value end,
    })

    MainTab:CreateSlider({
       Name = "1.1 Aim Height Offset (แก้อาการเป้าลงต่ำ)",
       Range = {-2, 5},
       Increment = 0.5,
       Suffix = "m",
       CurrentValue = 1.0,
       Callback = function(Value) AimOffsetY = Value end,
    })

    MainTab:CreateToggle({
       Name = "2. Show FOV (วงกลมเป้า)",
       CurrentValue = false,
       Callback = function(Value) FOVCircleEnabled = Value end,
    })

    MainTab:CreateSlider({
       Name = "2.1 FOV Radius (ขนาดวงกลม)",
       Range = {50, 800},
       Increment = 10,
       Suffix = "px",
       CurrentValue = 250,
       Callback = function(Value)
          FOVRadius = Value
          if FOVCircle then FOVCircle.Radius = Value end
       end,
    })

    MainTab:CreateToggle({
       Name = "3. Enemy ESP (มองทะลุ)",
       CurrentValue = false,
       Callback = function(Value) ESPEnabled = Value end,
    })

    MainTab:CreateToggle({
       Name = "4. Enemy Tracers (เส้นชี้เป้า)",
       CurrentValue = false,
       Callback = function(Value) TracersEnabled = Value end,
    })

    -- 🔫 ระบบดัดแปลงปืนแท้ในตัว (Gun Mods)
    MainTab:CreateToggle({
       Name = "🔥 5. กระสุนไม่จำกัด (Inf Ammo)",
       CurrentValue = false,
       Callback = function(Value) InfiniteAmmo = Value end,
    })

    MainTab:CreateToggle({
       Name = "⚡ 6. ยิงรัวขึ้น (Rapid Fire)",
       CurrentValue = false,
       Callback = function(Value) RapidFire = Value end,
    })

    MainTab:CreateToggle({
       Name = "🎯 7. ปืนไม่ส่าย / ไร้แรงถอย (No Recoil)",
       CurrentValue = false,
       Callback = function(Value) NoRecoil = Value end,
    })

    -- Loop ดัดแปลงปืนใน Backpack และในมือ
    task.spawn(function()
        while task.wait(0.3) do
            pcall(function()
                local char = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                
                local weapons = {}
                if backpack then
                    for _, tool in pairs(backpack:GetChildren()) do table.insert(weapons, tool) end
                end
                if char then
                    for _, tool in pairs(char:GetChildren()) do
                        if tool:IsA("Tool") then table.insert(weapons, tool) end
                    end
                end

                for _, weapon in pairs(weapons) do
                    for _, obj in pairs(weapon:GetDescendants()) do
                        if obj:IsA("Value") or obj:IsA("ModuleScript") then
                            local name = string.lower(obj.Name)
                            
                            -- กระสุนไม่จำกัด
                            if InfiniteAmmo then
                                if string.find(name, "ammo") or string.find(name, "clip") or string.find(name, "stored") then
                                    if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                                        obj.Value = 999
                                    end
                                end
                            end

                            -- ยิงรัว
                            if RapidFire then
                                if string.find(name, "firemode") or string.find(name, "cooldown") or string.find(name, "firerate") then
                                    if obj:IsA("NumberValue") then obj.Value = 0.01 end
                                end
                            end

                            -- ไร้แรงถอย
                            if NoRecoil then
                                if string.find(name, "recoil") or string.find(name, "spread") then
                                    if obj:IsA("NumberValue") or obj:IsA("Vector3Value") then
                                        if obj:IsA("NumberValue") then obj.Value = 0 end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)

    -- Render Loop
    RunService.RenderStepped:Connect(function()
        if FOVCircle then
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            FOVCircle.Radius = FOVRadius
            FOVCircle.Visible = FOVCircleEnabled
        end

        local targetPlayer = GetClosestTarget()

        -- Aimbot
        if AimbotEnabled and targetPlayer and targetPlayer.Character then
            local targetPos = GetTargetPosition(targetPlayer.Character)
            if targetPos then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
            end
        end

        -- ESP & Tracers
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local targetPos = GetTargetPosition(player.Character)
                if targetPos then
                    local highlight = player.Character:FindFirstChild("ESPHighlight")
                    if ESPEnabled then
                        if not highlight then
                            highlight = Instance.new("Highlight")
                            highlight.Name = "ESPHighlight"
                            highlight.FillColor = Color3.fromRGB(128, 0, 128)
                            highlight.Parent = player.Character
                        end
                    else
                        if highlight then highlight:Destroy() end
                    end
                end
            end
        end
    end)

    Rayfield:Notify({ Title = "Galaxy Hub Ready", Content = "โหลดระบบเรียบร้อยแล้ว!", Duration = 4 })
end)
