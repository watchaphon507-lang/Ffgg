-- ฟังก์ชั่นค้นหาเป้าหมายที่ใกล้เมาส์ที่สุด
local function GetClosestPlayer()
    local Closest = nil
    local ShortestDistance = Settings.FOVRadius

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild(Settings.TargetPart) and v.Character:FindFirstChildOfClass("Humanoid") then
            if v.Character.Humanoid.Health > 0 then
                local PartPos, OnScreen = Camera:WorldToViewportPoint(v.Character[Settings.TargetPart].Position)
                if OnScreen then
                    local MousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local Distance = (Vector2.new(PartPos.X, PartPos.Y) - MousePos).Magnitude
                    if Distance < ShortestDistance then
                        Closest = v.Character[Settings.TargetPart]
                        ShortestDistance = Distance
                    end
                end
            end
        end
    end
    return Closest
end

-- การจัดการ ESP และ Tracers แบบ Dynamic
local Drawings = {}

local function ClearDrawings()
    for _, d in pairs(Drawings) do
        if d.Box then d.Box:Remove() end
        if d.Tracer then d.Tracer:Remove() end
    end
    Drawings = {}
end

-- Main Render Loop
RunService.RenderStepped:Connect(function()
    -- อัปเดตตำแหน่ง FOV Circle
    local CenterScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Position = CenterScreen

    -- Aimbot Loop
    if Settings.AimbotEnabled then
        local Target = GetClosestPlayer()
        if Target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Target.Position)
        end
    end

    -- ESP & Tracer Loop
    ClearDrawings()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                -- Render Tracers
                if Settings.ESP_Tracer then
                    local line = Drawing.new("Line")
                    line.Visible = true
                    line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    line.To = Vector2.new(pos.X, pos.Y)
                    line.Color = Color3.fromRGB(255, 0, 0)
                    line.Thickness = 1.5
                    table.insert(Drawings, {Tracer = line})
                end

                -- Render Box ESP
                if Settings.ESP_Box then
                    local box = Drawing.new("Square")
                    box.Visible = true
                    box.Size = Vector2.new(2000 / pos.Z, 3000 / pos.Z)
                    box.Position = Vector2.new(pos.X - box.Size.X / 2, pos.Y - box.Size.Y / 2)
                    box.Color = Color3.fromRGB(255, 0, 0)
                    box.Thickness = 1.5
                    box.Filled = false
                    table.insert(Drawings, {Box = box})
                end
            end
        end
    end
end)
