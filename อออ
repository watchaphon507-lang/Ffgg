-- Main Render Loop
local TracerLines = {}
local HighlightBoxes = {}

RunService.RenderStepped:Connect(function()
    -- อัปเดตตำแหน่งวงกลมตามเมาส์
    FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y + 36) -- ชดเชยระยะ Topbar

    local target = getClosestEnemy()

    -- 1. Aimbot System
    if Config.Aimbot and target and target.Character and target.Character:FindFirstChild(Config.AimPart) then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character[Config.AimPart].Position)
    end

    -- เคลียร์วาดเก่า
    for _, line in pairs(TracerLines) do line:Remove() end
    table.clear(TracerLines)

    for _, highlight in pairs(HighlightBoxes) do highlight:Destroy() end
    table.clear(HighlightBoxes)

    -- วนลูปแสดงผล Visuals
    for _, player in pairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            
            -- 3. Tracers สีแดง
            if Config.Tracers then
                local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                if onScreen then
                    local line = Drawing.new("Line")
                    line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    line.To = Vector2.new(pos.X, pos.Y)
                    line.Color = Color3.fromRGB(255, 0, 0) -- สีแดง
                    line.Thickness = 1.5
                    line.Transparency = 1
                    line.Visible = true
                    table.insert(TracerLines, line)
                end
            end

            -- 5. ESP สีม่วง
            if Config.ESP_Box then
                if not player.Character:FindFirstChild("ESPHighlight") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESPHighlight"
                    highlight.Adornee = player.Character
                    highlight.FillColor = Color3.fromRGB(128, 0, 128) -- สีม่วง
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = player.Character
                    table.insert(HighlightBoxes, highlight)
                end
            end
        end
    end
end)

-- 6. Hook Event กระสุนไปหาศัตรู (SpawnGalaxy)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local originalFireServer

task.spawn(function()
    local remote = ReplicatedStorage:WaitForChild("SpawnGalaxy", 5)
    if remote and remote:IsA("RemoteEvent") then
        local gmt = getrawmetatable(game)
        local oldIndex = gmt.__namecall
        setreadonly(gmt, false)

        gmt.__namecall = newcclosure(function(self, ...)
            local args = {...}
            local method = getnamecallmethod()

            if self == remote and method == "FireServer" and Config.SilentAim then
                local closest = getClosestEnemy()
                if closest and closest.Character and closest.Character:FindFirstChild(Config.AimPart) then
                    -- ปรับเปลี่ยนตำแหน่งเป้าหมายใน Event ให้ยิงเข้าตัวศัตรูโดยตรง
                    args[1] = closest.Character[Config.AimPart].Position
                    return oldIndex(self, unpack(args))
                end
            end

            return oldIndex(self, ...)
        end)
        setreadonly(gmt, true)
    end
end)
