})

-- 5. ESP Box
MainTab:CreateToggle({
   Name = "5. ESP Box (กรอบสีม่วง)",
   CurrentValue = false,
   Callback = function(Value) ESPEnabled = Value end,
})

-- 6. Silent Aim
MainTab:CreateToggle({
   Name = "6. Silent Aim (กระสุนไปหาศัตรู)",
   CurrentValue = false,
   Callback = function(Value) SilentAimEnabled = Value end,
})

-- Storage สำหรับเก็บเส้น Tracers
local TracersList = {}

-- Main Render Loop
RunService.RenderStepped:Connect(function()
    -- อัปเดตเป้าเหลืองกลางจอ
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Visible = FOVCircleEnabled

    local targetPlayer, targetPart = GetClosestTarget()

    -- 1. Aimbot Logic
    if AimbotEnabled and targetPart then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
    end

    -- Loop จัดการ ESP และ Tracers สำหรับทุกคน
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local rootPart = GetTargetPart(player.Character)
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")

            if rootPart and (not humanoid or humanoid.Health > 0) then
                
                -- [5] ESP Highlight (กรอบสีม่วง)
                local highlight = player.Character:FindFirstChild("ESPHighlight")
                if ESPEnabled then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "ESPHighlight"
                        highlight.FillColor = Color3.fromRGB(130, 0, 200) -- สีม่วง
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.FillTransparency = 0.4
                        highlight.Parent = player.Character
                    end
                else
                    if highlight then highlight:Destroy() end
                end

                -- [3] Tracers (เส้นสีแดง)
                if TracersEnabled then
                    if not TracersList[player] then
                        TracersList[player] = Drawing.new("Line")
                        TracersList[player].Color = Color3.fromRGB(255, 0, 0) -- สีแดง
                        TracersList[player].Thickness = 1.5
                    end

                    local pos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    if onScreen then
                        TracersList[player].From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y) -- ล่างจอ
                        TracersList[player].To = Vector2.new(pos.X, pos.Y)
                        TracersList[player].Visible = true
                    else
                        TracersList[player].Visible = false
                    end
                else
                    if TracersList[player] then TracersList[player].Visible = false end
                end

            else
                -- ลบออกถ้าผู้เล่นตายหรือออกจากระยะ
                if TracersList[player] then TracersList[player].Visible = false end
                if player.Character:FindFirstChild("ESPHighlight") then
                    player.Character.ESPHighlight:Destroy()
                end
            end
        end
    end
end)

-- [6] Silent Aim Loop (กระสุนไปหาศัตรู)
task.spawn(function()
    while task.wait(0.05) do
        if SilentAimEnabled then
            local targetPlayer, targetPart = GetClosestTarget()
            if targetPart then
                pcall(function()
                    -- ยิง Event ไปหาตำแหน่งเป้าหมาย
                    ReplicatedStorage.SpawnGalaxyBlock.Event:FireServer(targetPart.Position)
                end)
            end
        end
    end
end)
